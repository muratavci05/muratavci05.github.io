---
import { t, ui } from "../data/i18n";
import { projects } from "../data/projects";
import type { Lang } from "../data/types";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = ui[lang];
---

<section class="section" aria-labelledby="work-title">
  <h2 class="label" id="work-title">{s.work}</h2>
  <ol class="work">
    {
      projects.map((p) => (
        <li class="item">
          <div class="head">
            <h3>
              {p.url ? (
                <a href={p.url} target="_blank" rel="noopener">
                  {t(p.name, lang)} ↗
                </a>
              ) : (
                t(p.name, lang)
              )}
            </h3>
            <span class:list={["status", p.status]}>{s.status[p.status]}</span>
          </div>
          <p>{p.summary[lang]}</p>
          <div class="check">
            <b>{s.check[p.check.label]}</b>
            <span>{p.check.text[lang]}</span>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .work {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .item {
    display: grid;
    gap: 6px;
    padding-block: 20px;
    border-bottom: 1px solid var(--line);
  }
  .item:first-child {
    padding-top: 0;
  }
  .head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  h3 {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: -0.01em;
    margin: 0;
  }
  h3 a {
    text-decoration: none;
    border-bottom: 1.5px solid var(--accent);
  }
  h3 a:hover {
    color: var(--accent);
  }
  .status {
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .status.live {
    color: var(--pass);
    border-color: color-mix(in srgb, var(--pass) 45%, transparent);
  }
  .status.private {
    color: var(--signal);
    border-color: color-mix(in srgb, var(--signal) 50%, transparent);
  }
  p {
    margin: 0;
    max-width: 40em;
  }
  .check {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px;
    align-items: baseline;
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.94rem;
  }
  .check b {
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--pass);
    white-space: nowrap;
  }
</style>
