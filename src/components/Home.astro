---
import Layout from "../layouts/Layout.astro";
import Hero from "./Hero.astro";
import Principles from "./Principles.astro";
import Record from "./Record.astro";
import Work from "./Work.astro";
import { homePath } from "../data/i18n";
import { profile } from "../data/profile";
import type { Lang } from "../data/types";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Layout
  lang={lang}
  title={`${profile.name} · AI Engineer`}
  description={profile.description[lang]}
  alternates={homePath}
>
  <Hero lang={lang} />
  <Work lang={lang} />
  <Principles lang={lang} />
  <Record lang={lang} />
</Layout>
