---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Principles from "./Principles.astro";
import Record from "./Record.astro";
import Work from "./Work.astro";
import { profile } from "../data/profile";
import type { Lang } from "../data/types";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Layout lang={lang} title={`${profile.name} · AI Engineer`} description={profile.description[lang]}>
  <Header lang={lang} />
  <Hero lang={lang} />
  <Work lang={lang} />
  <Principles lang={lang} />
  <Record lang={lang} />
  <footer>
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <span>{profile.location}</span>
  </footer>
</Layout>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding-top: 22px;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    font-family: var(--f-mono);
    font-size: 0.74rem;
    color: var(--muted);
  }
</style>
