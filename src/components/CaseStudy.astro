---
import Layout from "../layouts/Layout.astro";
import Diagram from "./Diagram.astro";
import { casePath, homePath, t, ui } from "../data/i18n";
import { profile } from "../data/profile";
import { projects } from "../data/projects";
import type { Lang, Project } from "../data/types";

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project: p } = Astro.props;
const s = ui[lang];
const name = t(p.name, lang);
const index = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(index + 1) % projects.length];
---

<Layout
  lang={lang}
  title={`${name} · ${s.caseStudy} · ${profile.name}`}
  description={`${name}: ${p.summary[lang]}`}
  alternates={{ en: casePath(p.slug, "en"), de: casePath(p.slug, "de") }}
>
  <article>
    <a class="back" href={`${homePath[lang]}#work`}>← {s.back}</a>
    <p class="label">{s.caseStudy} · {p.proves[lang]}</p>
    <div class="title">
      <h1>{name}</h1>
      <span class:list={["status", p.status]}>{s.status[p.status]}</span>
    </div>
    <p class="lede">{p.summary[lang]}</p>
    {
      p.url && (
        <a class="visit" href={p.url} target="_blank" rel="noopener">
          {s.visit} ↗
        </a>
      )
    }

    <section class="block">
      <h2 class="label">{s.problem}</h2>
      <p class="prose">{p.problem[lang]}</p>
    </section>

    <section class="block">
      <h2 class="label">{s.architecture}</h2>
      <Diagram kind={p.diagram} lang={lang} />
    </section>

    <section class="block">
      <h2 class="label">{s.built}</h2>
      <ul class="list">{p.built[lang].map((item) => <li>{item}</li>)}</ul>
    </section>

    <section class="block">
      <h2 class="label">{s.decisions}</h2>
      <ol class="decisions">
        {
          p.decisions.map((d) => (
            <li>
              <strong>{d.title[lang]}</strong>
              <span>{d.text[lang]}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="block">
      <h2 class="label">{s.evaluation}</h2>
      <ul class="checks">{p.evaluation[lang].map((item) => <li>{item}</li>)}</ul>
    </section>

    {
      next && next.slug !== p.slug && (
        <a class="next" href={casePath(next.slug, lang)}>
          <span class="label">{s.next}</span>
          <strong>{t(next.name, lang)} →</strong>
        </a>
      )
    }
  </article>
</Layout>

<style>
  article {
    padding-bottom: 32px;
  }
  .back {
    display: inline-block;
    margin-bottom: 28px;
    font-family: var(--f-mono);
    font-size: 0.78rem;
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--ink);
  }
  .title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  h1 {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 7vw, 3.2rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .status {
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .status.live {
    color: var(--pass);
    border-color: color-mix(in srgb, var(--pass) 45%, transparent);
  }
  .status.private {
    color: var(--signal);
    border-color: color-mix(in srgb, var(--signal) 50%, transparent);
  }
  .lede {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(1.2rem, 3vw, 1.45rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 18px 0 0;
    max-width: 30em;
    text-wrap: balance;
  }
  .visit {
    display: inline-block;
    margin-top: 18px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1.5px solid currentColor;
  }
  .block {
    padding-top: 34px;
    margin-top: 34px;
    border-top: 1px solid var(--line);
  }
  .prose {
    margin: 0;
    max-width: 38em;
    font-size: 1.05rem;
  }
  .list,
  .checks,
  .decisions {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .list li {
    padding-left: 18px;
    position: relative;
    max-width: 40em;
  }
  .list li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--muted);
  }
  .decisions {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    counter-reset: d;
  }
  @media (max-width: 620px) {
    .decisions {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .decisions li {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px;
    counter-increment: d;
  }
  .decisions li::before {
    content: counter(d, decimal-leading-zero);
    display: block;
    font-family: var(--f-mono);
    font-size: 0.7rem;
    color: var(--accent);
    margin-bottom: 6px;
  }
  .decisions strong {
    display: block;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .decisions span {
    color: var(--muted);
    font-size: 0.94rem;
  }
  .checks li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px;
    align-items: baseline;
  }
  .checks li::before {
    content: "✓";
    font-family: var(--f-mono);
    color: var(--pass);
  }
  .next {
    display: grid;
    gap: 4px;
    margin-top: 44px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    text-decoration: none;
  }
  .next:hover {
    border-color: var(--ink);
  }
  .next .label {
    margin: 0;
  }
  .next strong {
    font-family: var(--f-display);
    font-size: 1.25rem;
  }
</style>
