---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";
import "@fontsource/instrument-sans/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import { profile } from "../data/profile";
import { LANGS, type Lang } from "../data/types";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** The same page in every language, used for hreflang and the language switch. */
  alternates: Record<Lang, string>;
}

const { lang, title, description, alternates } = Astro.props;
const site = Astro.site ?? new URL("https://muratavci05.github.io");
const canonical = new URL(alternates[lang], site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(alternates[l], site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "de" ? "de_DE" : "en_US"} />
    <meta property="og:image" content={new URL("/og.png", site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Murat Avci, AI Engineer. A real LinguBase result: B1, 87 % confidence." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og.png", site).href} />
    <script is:inline>
      try {
        const saved = localStorage.getItem("ma-theme");
        if (saved === "dark" || saved === "light") document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <div class="page">
      <Header lang={lang} alternates={alternates} />
      <slot />
      <footer>
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <span>{profile.location}</span>
      </footer>
    </div>
  </body>
</html>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding-top: 22px;
    margin-top: 8px;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    font-family: var(--f-mono);
    font-size: 0.74rem;
    color: var(--muted);
  }
</style>
